# Local safety copies taken before large edits. Useful on disk, noise in history.
index.backup-*.html

# Design doc: references absolute paths on my machine, and a course-code
# integration that is planned rather than shipped. Delete this line to publish it.
PLAN-study-tracker.md

# Tauri desktop shell build output and generated files — never committed.
# The shell sources (Cargo.toml, src/, *.sh, tauri.conf.json, capabilities/)
# are committed; everything Tauri generates or compiles is not.
src-tauri/target/
src-tauri/gen/schemas/
# gen/android is committed: it carries the manifest permissions and signing
# config (PLAN-android.md B2). Its own .gitignore drops build output.
src-tauri/icons/
src-tauri/dist/

# Generated by the vendored plugin's build.rs on every build.
src-tauri/plugins/notification/android/.tauri/
src-tauri/plugins/notification/android/build/

# Editor / OS
.DS_Store
*.swp
.vscode/
.idea/
