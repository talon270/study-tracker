{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study Tracker",
  "version": "1.0.0",
  "identifier": "com.talon.studytracker",
  "build": {
    "frontendDist": "dist",
    "beforeBuildCommand": "sh src-tauri/copy-assets.sh",
    "beforeDevCommand": "sh src-tauri/copy-assets.sh"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Study Tracker",
        "width": 1200,
        "height": 900,
        "minWidth": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {}
}
